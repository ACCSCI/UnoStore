{
  "name": "unostore",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --port 25000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "check:card-art": "bun run scripts/check-card-art.ts",
    "check:text-selection": "bun run scripts/check-text-selection.ts",
    "analyze:roulette": "bun run scripts/roulette-ab.ts",
    "optimize:media": "pwsh -NoProfile -File scripts/optimize-media.ps1",
    "replay": "bun run scripts/replay.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "compress": "bunx gltf-transform optimize --compress draco --texture-compress webp --texture-size 1024 public/assets/table.glb public/assets/table.compressed.glb",
    "blender:export": "bun run scripts/blender_export.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@gltf-transform/cli": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@types/bun": "^1.3.14",
    "@types/three": "^0.185.1",
    "lefthook": "^2.1.10",
    "puppeteer-core": "^25.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
