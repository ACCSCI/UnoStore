{
  "name": "unostore",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "replay": "bun run scripts/replay.ts",
    "lint": "@biomejs/biome check .",
    "lint:fix": "@biomejs/biome check --write .",
    "format": "@biomejs/biome format --write .",
    "compress": "bunx gltf-transform optimize --compress draco --texture-compress webp --texture-size 1024 public/assets/table.glb public/assets/table.compressed.glb",
    "blender:export": "bun run scripts/blender_export.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@gltf-transform/cli": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@types/bun": "^1.3.14",
    "@types/three": "^0.185.1",
    "lefthook": "^2.1.10",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
